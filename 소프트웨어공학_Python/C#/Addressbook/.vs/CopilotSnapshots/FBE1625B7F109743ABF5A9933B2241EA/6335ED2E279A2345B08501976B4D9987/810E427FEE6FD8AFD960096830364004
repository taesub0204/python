        private void button14_Click(object sender, EventArgs e)
        {
            // textBox1.text에 입력 받은 값을 계산

            try
            {
                // "x"를 "*"로 변환 (컴퓨터는 *를 곱하기로 이해)
                string expression = textBox1.Text.Replace("x", "*");

                // DataTable.Compute로 자동 계산
                DataTable dt = new DataTable();
                var result = dt.Compute(expression, "");

                // 결과 표시
                textBox1.Text = result.ToString();
                display.Text = result.ToString();
            }
            catch (Exception ex)
            {
                // 오류 발생시
                textBox1.Text = "오류";
                display.Text = "수식 오류";
            }
        }

