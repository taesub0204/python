using System;
using System.Collections.Generic;
using System.ComponentModel;
using System.Data;
using System.Drawing;
using System.Linq;
using System.Text;
using System.Threading.Tasks;
using System.Windows.Forms;

namespace Addressbook
{
    public partial class Adder : Form
    {
        // 갤럭시 계산기 스타일 변수
        string currentInput = "0";      // 현재 입력 중인 숫자 문자열
        double storedValue = 0;         // 저장된 값 (이전 계산 결과)
        string currentOperator = "";    // 현재 연산자
        bool startNewInput = true;      // 새로운 숫자 입력 시작 여부
        string expressionDisplay = "";  // 위쪽 수식 표시




        public Adder()
        {
            InitializeComponent();
            UpdateDisplay();
        }

        // 디스플레이 업데이트 (위: 수식, 아래: 현재 입력/결과)
        private void UpdateDisplay()
        {
            txtAnswer.Text = expressionDisplay + Environment.NewLine + currentInput;
        }


        // 숫자 버튼 클릭 (0~9)
        private void Number_Click(object sender, EventArgs e)
        {
            Button btn = (Button)sender;
            string number = btn.Text;

            // 새로운 입력 시작이면 기존 값을 지우고 새로 시작
            if (startNewInput)
            {
                currentInput = number;
                startNewInput = false;
            }
            else
            {
                // 0만 있으면 덮어쓰기, 아니면 이어붙이기
                if (currentInput == "0")
                    currentInput = number;
                else
                    currentInput += number;
            }

            UpdateDisplay();
        }

        // 실제 계산 수행
        private double PerformCalculation(double value1, string op, double value2)
        {
            switch (op)
            {
                case "+": return value1 + value2;
                case "-": return value1 - value2;
                case "×": return value1 * value2;
                case "÷":
                    if (value2 == 0)
                    {
                        MessageBox.Show("0으로 나눌 수 없습니다.");
                        return 0;
                    }
                    return value1 / value2;
                default:
                    return value2;
            }
        }




        // 연산자 버튼 클릭 (+, -, ×, ÷)
        private void Operator_click(object sender, EventArgs e)
        {
            Button btn = (Button)sender;
            string newOperator = btn.Text;

            // 현재 입력된 숫자
            double currentValue = Convert.ToDouble(currentInput);

            // 이전 연산자가 있으면 먼저 계산
            if (currentOperator != "")
            {
                storedValue = PerformCalculation(storedValue, currentOperator, currentValue);
                currentInput = storedValue.ToString();
            }
            else
            {
                // 첫 번째 연산자: 현재 값을 저장
                storedValue = currentValue;
            }

            // 수식 표시 업데이트 (갤럭시 스타일)
            expressionDisplay = storedValue + " " + newOperator;

            // 새 연산자 저장
            currentOperator = newOperator;
            startNewInput = true;

            UpdateDisplay();
        }

        // = 버튼 클릭
        private void equals_Click(object sender, EventArgs e)
        {
            // 연산자가 있으면 최종 계산
            if (currentOperator != "")
            {
                double currentValue = Convert.ToDouble(currentInput);
                storedValue = PerformCalculation(storedValue, currentOperator, currentValue);

                // 수식 표시에 = 추가
                expressionDisplay += " " + currentValue + " =";
                currentInput = storedValue.ToString();

                // 초기화
                currentOperator = "";
                startNewInput = true;
            }

            UpdateDisplay();
        }

