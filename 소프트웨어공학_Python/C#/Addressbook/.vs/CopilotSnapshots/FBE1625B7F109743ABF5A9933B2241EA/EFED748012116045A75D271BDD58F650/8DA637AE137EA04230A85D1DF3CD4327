            InitializeComponent();
            updateDisplay();
        }

        private void updateDisplay()
        {
            txtAnswer.Text = expressionText + Environment.NewLine + resultText;
        }


        private void Number_Click(object sender, EventArgs e)
        {
            Button btn = (Button)sender;

            // 연산자를 눌렀으면 새로운 숫자 입력 시작
            if (expressionText == "" || currentNum == 0)
            
                currentNum = Convert.ToDouble(btn.Text);
              
            

            else
             
              currentNum = Convert.ToDouble(currentNum.ToString()+btn.Text);
            



            expressionText += btn.Text;

            //if (isOperationClicked) { 
            //    Calculate(currentNum);
            //    currentNum = 0;
            //    isOperationClicked = false;
            //    resultText = resultNum.ToString();

            //}



            updateDisplay();
        }

        private void Calculate(double num)
        {
            switch (operation)
            {
                case "+":
                    resultNum += num; break;
                case "-":
                    resultNum -= num; break;
                case "×":
                    resultNum *= num; break;
                case "÷":
                    if (num == 0)
                    {
                        MessageBox.Show("0으로 나눌 수 없습니다.");
                        return;
                    }
                    resultNum /= num; 
                    break;



            }
        }




        private void Operator_click(object sender, EventArgs e)
        {

            Button btn = (Button)sender;
            operation = btn.Text;
            if (resultNum == 0 && currentNum != 0)
            {
                resultNum = currentNum;
                isOperationClicked = false;
            }

            isOperationClicked = true;
            expressionText += btn.Text;
            resultText = "";
            updateDisplay();

        }
        private void equals_Click(object sender, EventArgs e)
        {
            // 현재 입력된 숫자로 최종 계산
            if (!string.IsNullOrEmpty(txtAnswer.Text) && txtAnswer.Text != "0")
            {
                //문자열 


                currentNum = Convert.ToInt32(txtAnswer.Text);
            }

            Calculate(currentNum);

            expressionText += " = ";
            resultText = resultNum.ToString();
            updateDisplay();

            // 초기화 (다음 계산을 위해)
            operation = "";
            isOperationClicked = false;
        }

