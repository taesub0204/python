        {

        }

        // AC 버튼 (전체 초기화)
        private void btnAC_Click(object sender, EventArgs e)
        {
            displayExpression = "";
            displayResult = "0";
            firstValue = 0;
            secondValue = 0;
            operation = "";
            isNewNumber = true;
            hasOperator = false;

            UpdateDisplay();
        }

